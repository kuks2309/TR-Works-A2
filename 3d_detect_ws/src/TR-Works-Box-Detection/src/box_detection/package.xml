<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>box_detection</name>
  <version>0.1.0</version>
  <description>Box / table-top plane detection from RealSense rosbag PointCloud2 streams (ground + box-top plane RANSAC).</description>
  <maintainer email="kukwonko@gmail.com">amap</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>rosbag2_py</depend>
  <depend>sensor_msgs</depend>
  <depend>sensor_msgs_py</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_msgs</depend>

  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
