# OpenArmX VLA 一键启动配置
# 修改参数后，执行 scripts/vla_collect_gui.sh
#
# 常用命令：
#   bash scripts/vla_collect_gui.sh check
#   bash scripts/vla_collect_gui.sh base
#   bash scripts/vla_collect_gui.sh base_camera
#   bash scripts/vla_collect_gui.sh collect
#   bash scripts/vla_collect_gui.sh stop
#
# 说明：
# - `base` 只启动机器人真机 + Pico Bridge + VR Teleop
# - `base_camera` 在 `base` 基础上增加三相机发布
# - `collect` 在 `base_camera` 基础上增加 LeRobot 数采
# - `stop` 关闭本脚本拉起的终端窗口

# ------------------------------
# 基础路径
# ------------------------------
# ROS 2 工作空间根目录，脚本会使用 `$WORKSPACE_DIR/install/setup.bash`
WORKSPACE_DIR=/home/openarmx/openarmx_ws
# 进入 LeRobot 环境的命令；仅 `collect` 模式会使用
LEROBOT_ENV_CMD=lerobot-env
# 图形终端命令，脚本通过它弹出多个窗口
GUI_TERMINAL=gnome-terminal
# 连续打开多个终端窗口时的间隔，避免同时拉起过快
OPEN_WINDOW_INTERVAL_S=0.8
# 记录当前这组 GUI 终端进程状态的文件，`stop` 依赖它精确关闭
STATE_FILE=/tmp/openarmx_vla_collect_gui.state

# ------------------------------
# 模式 1：机器人底层
# ------------------------------
# 机器人控制模式；与手动 bringup 命令的 `control_mode:=...` 对应
CONTROL_MODE=mit
# 控制器名称；与手动 bringup 命令的 `robot_controller:=...` 对应
ROBOT_CONTROLLER=forward_position_controller
# 是否使用仿真硬件；真机一般设为 false
USE_FAKE_HARDWARE=false

# ------------------------------
# Pico / VR 遥操作参数
# ------------------------------
# 是否连接 LeRobot 相关接口；通常保持 false
CONNECT_LEROBOT=false
# 是否通过 xacro 生成模型；通常保持 true
USE_XACRO=true
# 控制速率来源话题
RATE_TOPIC=/pico_right_controller/rate
# 慢速模式下单次最大步进角度（度）
SLOW_MAX_STEP_DEG=1.0
# 快速模式下单次最大步进角度（度）
FAST_MAX_STEP_DEG=12.0
# 遥操作主循环控制频率（Hz）
TELEOP_CONTROL_RATE=100.0
# 逆运动学每次迭代次数
IK_ITERATIONS=3
# 是否发布可视化 TF
PUBLISH_VISUALIZATION_TF=true
# 是否打印性能日志
PRINT_PERFORMANCE=false
# 是否启用 link4 拓展结构；按机器人硬件配置设置
USE_LINK4_EXT=true
# 约束模式，例如 `joint`
CONSTRAINT_MODE=joint
# 抓取动作阈值
GRIP_THRESHOLD=0.5
# 左手抓取输入话题
LEFT_GRIP_TOPIC=/pico_left_controller/grip
# 右手抓取输入话题
RIGHT_GRIP_TOPIC=/pico_right_controller/grip

# 各窗口启动前延时，单位秒。
# 用于让前一模块先稳定起来，再启动下一模块。
# `base` 使用前三项，`base_camera` 会再用 CAMERA_START_DELAY_S，
# `collect` 会继续使用 RECORD_START_DELAY_S。
BRIDGE_START_DELAY_S=1
TELEOP_START_DELAY_S=2
CAMERA_START_DELAY_S=3
RECORD_START_DELAY_S=5

# ------------------------------
# 模式 2：相机发布参数
# 相机与录制的 W/H/FPS 必须一致
# ------------------------------
# 三台相机统一分辨率宽度
W=424
# 三台相机统一分辨率高度
H=240
# 三台相机统一帧率，同时也会写入 `lerobot-record`
FPS=30

# 左手相机序列号与型号（D405 / D435）
CAM_LEFT_SERIAL=218622270388
CAM_LEFT_TYPE=D405
# 右手相机序列号与型号（D405 / D435）
CAM_RIGHT_SERIAL=218622274446
CAM_RIGHT_TYPE=D405
# 头部相机序列号与型号（D405 / D435）
CAM_HEAD_SERIAL=335522070220
CAM_HEAD_TYPE=D435

# 颜色参数说明：
# - `*_AUTO_EXPOSURE` / `*_AUTO_WHITE_BALANCE` 支持 `true` / `false` / `unset`
# - 其余曝光、增益、白平衡、亮度、对比度、饱和度、锐度支持整数
# - `unset` 表示启动脚本会把参数原样传给 launch，由底层保持默认行为
# - 左 / 右 / 头三台相机参数分别独立设置
# 在将自动曝光AUTO_EXPOSURE设为true时，手动曝光参数如CAM_LEFT_COLOR_EXPOSURE，CAM_LEFT_COLOR_GAIN无效
# 如想要使用手动曝光，请将AUTO_EXPOSURE设为false

# 左手相机颜色参数
CAM_LEFT_COLOR_AUTO_EXPOSURE=true
CAM_LEFT_COLOR_EXPOSURE=10000
CAM_LEFT_COLOR_GAIN=unset
CAM_LEFT_COLOR_AUTO_WHITE_BALANCE=unset
CAM_LEFT_COLOR_WHITE_BALANCE=unset
CAM_LEFT_COLOR_BRIGHTNESS=unset
CAM_LEFT_COLOR_CONTRAST=unset
CAM_LEFT_COLOR_SATURATION=unset
CAM_LEFT_COLOR_SHARPNESS=unset

# 右手相机颜色参数
CAM_RIGHT_COLOR_AUTO_EXPOSURE=true
CAM_RIGHT_COLOR_EXPOSURE=10000
CAM_RIGHT_COLOR_GAIN=32
CAM_RIGHT_COLOR_AUTO_WHITE_BALANCE=unset
CAM_RIGHT_COLOR_WHITE_BALANCE=unset
CAM_RIGHT_COLOR_BRIGHTNESS=unset
CAM_RIGHT_COLOR_CONTRAST=unset
CAM_RIGHT_COLOR_SATURATION=unset
CAM_RIGHT_COLOR_SHARPNESS=unset

# 头部相机颜色参数
CAM_HEAD_COLOR_AUTO_EXPOSURE=true
CAM_HEAD_COLOR_EXPOSURE=10000
CAM_HEAD_COLOR_GAIN=unset
CAM_HEAD_COLOR_AUTO_WHITE_BALANCE=unset
CAM_HEAD_COLOR_WHITE_BALANCE=unset
CAM_HEAD_COLOR_BRIGHTNESS=unset
CAM_HEAD_COLOR_CONTRAST=unset
CAM_HEAD_COLOR_SATURATION=unset
CAM_HEAD_COLOR_SHARPNESS=unset

# ------------------------------
# 模式 3：LeRobot 数采参数
# ------------------------------
# 是否启用 Hugging Face Hub 离线模式；本地采集通常设为 1
HF_HUB_OFFLINE=1
# 数据集保存地址；例如 `local/take_box`  ⚠️ 每次开始数采前请修改为新的保存地址，若与之前使用的地址重复，会报错。`
DATASET_REPO_ID=local/take_box13
# 当前任务描述，会写入数据集元信息
DATASET_SINGLE_TASK="take box"
# 计划采集的总 episode 数量
DATASET_NUM_EPISODES=70
# 单个 episode 最长时长（秒）
DATASET_EPISODE_TIME_S=180
# episode 结束后的重置等待时间（秒）
DATASET_RESET_TIME_S=5
# 是否自动上传到 Hugging Face Hub
DATASET_PUSH_TO_HUB=false
# 是否显示实时数据画面与状态
DISPLAY_DATA=true

# 可选项：留空则不传给 `lerobot-record`
# - `DATASET_ROOT`：自定义数据保存根目录
# - `DATASET_FPS`：给录制逻辑单独指定 fps；通常留空，默认跟随 W/H/FPS
# - `DATASET_VIDEO`：是否启用视频编码
# - `DATASET_VCODEC`：视频编码器
# - `DATASET_VIDEO_ENCODING_BATCH_SIZE`：批量视频编码大小
# - `DATASET_PRIVATE`：上传 Hub 时是否设为私有
# - `DATASET_TAGS`：上传 Hub 时附加标签
# - `DATASET_NUM_IMAGE_WRITER_PROCESSES`：图像写入进程数
# - `DATASET_NUM_IMAGE_WRITER_THREADS_PER_CAMERA`：每个相机写入线程数
# - `DATASET_RENAME_MAP`：重命名观测字段
DATASET_ROOT=
DATASET_FPS=
DATASET_VIDEO=
DATASET_VCODEC=
DATASET_VIDEO_ENCODING_BATCH_SIZE=
DATASET_PRIVATE=
DATASET_TAGS=
DATASET_NUM_IMAGE_WRITER_PROCESSES=
DATASET_NUM_IMAGE_WRITER_THREADS_PER_CAMERA=
DATASET_RENAME_MAP=
