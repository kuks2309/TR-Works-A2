# OpenArmX VLA(Vision-Language-Action) — AI 백엔드 일괄 실행 설정 (China 워크스페이스 적응)
#
# 원본 openarmx_vla 는 VR(Pico) 텔레오퍼레이션 + 손목 D405 3캠을 가정하나,
# 본 AI 백엔드는 이 프로젝트 실제 구성에 맞춰 아래로 적응되었다.
#   - 텔레오퍼레이션: 물리 leader arm (teleop_bimanual, CAN 직접) — VR 아님
#   - 카메라: 중앙(헤드) D435 1대 (d435_camera.launch.py, /camera/camera/...)
#
# 사용:
#   bash scripts/vla_collect_gui.sh check
#   bash scripts/vla_collect_gui.sh base          # bringup + leader teleop
#   bash scripts/vla_collect_gui.sh base_camera   # + 중앙 D435
#   bash scripts/vla_collect_gui.sh collect       # + lerobot-record
#   bash scripts/vla_collect_gui.sh stop

# ------------------------------
# 기본 경로 / GUI(Graphical User Interface)
# ------------------------------
# ROS2(Robot Operating System 2) 워크스페이스 루트 (이 프로젝트 실제 경로)
WORKSPACE_DIR=/home/openarmx/TR-Works/kkw/China/openarmx_ws
# LeRobot 환경 진입 명령 (collect 모드에서만 사용)
LEROBOT_ENV_CMD=lerobot-env
# 그래픽 터미널 명령
GUI_TERMINAL=gnome-terminal
# 연속 창 오픈 간격(초)
OPEN_WINDOW_INTERVAL_S=0.8
# 창 상태 파일 (stop 이 이 파일로 정확히 종료)
STATE_FILE=/tmp/openarmx_ai_collect_gui.state

# ------------------------------
# 로봇 하위 계층 (openarmx_bringup)
# ------------------------------
# MIT(Motor Impedance Torque) 모드 + forward_position_controller 가 leader-follower/VLA 전제
CONTROL_MODE=mit
ROBOT_CONTROLLER=forward_position_controller
USE_FAKE_HARDWARE=false

# ------------------------------
# Leader arm 텔레오퍼레이션 (teleop_bimanual)
# leader CAN(Controller Area Network)에서 8DOF(7관절+그리퍼)를 읽어
# /{left,right}_forward_position_controller/commands 로 발행 → follower 구동 + 기록
# ⚠️ CAN 번호는 실제 배선과 일치시킬 것 (launch 기본: leader can0/can1)
# ------------------------------
LEADER_RIGHT_CAN=can0
LEADER_LEFT_CAN=can1
FOLLOWER_RIGHT_PREFIX=right
FOLLOWER_LEFT_PREFIX=left
CONTROL_RATE_HZ=200

# 각 창 시작 전 지연(초) — 앞 모듈 안정화 후 다음 기동
TELEOP_START_DELAY_S=3
CAMERA_START_DELAY_S=3
RECORD_START_DELAY_S=5

# ------------------------------
# 카메라 / 녹화 해상도 (중앙 D435 단일)
# ⚠️ W/H/FPS(Frames Per Second)는 d435_camera 실제 스트림과 반드시 일치해야 한다.
#    불일치 시 lerobot 데이터셋 shape 오류. 실제 값은 다음으로 확인:
#    ros2 topic echo --once /camera/camera/color/camera_info
#    (또는 openarmx_scenario_player/config/d435_qos.yaml 의 프로파일)
# ------------------------------
W=640
H=480
FPS=30

# ------------------------------
# LeRobot 데이터 수집 파라미터
# ------------------------------
HF_HUB_OFFLINE=1
# ⚠️ 매 수집 전 새 이름으로 변경 (중복 시 오류)
DATASET_REPO_ID=local/ai_take_box
DATASET_SINGLE_TASK="take box"
DATASET_NUM_EPISODES=70
DATASET_EPISODE_TIME_S=180
DATASET_RESET_TIME_S=5
DATASET_PUSH_TO_HUB=false
DISPLAY_DATA=true

# 선택 항목 (빈 값이면 lerobot-record 에 전달 안 함)
DATASET_ROOT=
DATASET_FPS=
DATASET_VIDEO=
DATASET_VCODEC=
DATASET_VIDEO_ENCODING_BATCH_SIZE=
DATASET_PRIVATE=
DATASET_TAGS=
DATASET_NUM_IMAGE_WRITER_PROCESSES=
DATASET_NUM_IMAGE_WRITER_THREADS_PER_CAMERA=
DATASET_RENAME_MAP=
