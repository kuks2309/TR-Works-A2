<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>openarmx_pick</name>
  <version>0.1.0</version>
  <description>
    Vision-driven single-arm pick for OpenArmX: top-down grasp-pose synthesis
    from box_plane detection, fed to the cyclo_control QP+CBF MoveL solver
    (MoveIt-free). Hosts the reduced single-arm solver URDF and launch glue.
  </description>
  <maintainer email="drko0808@gmail.com">openarmx</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <!-- QP MoveL solver node (cyclo_control) + its MoveL command msg -->
  <exec_depend>cyclo_motion_controller_ros</exec_depend>
  <exec_depend>openarmx_scenario_player_msgs</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
