       <item row="0" column="0"><widget class="QLabel" name="lblPath"><property name="text"><string>Path:</string></property></widget></item>
       <item row="0" column="1" colspan="2">
        <widget class="QLineEdit" name="txtScenarioPath">
         <property name="placeholderText"><string>Scenarios 디렉토리 경로</string></property>
