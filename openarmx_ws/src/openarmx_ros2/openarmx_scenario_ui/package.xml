<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>openarmx_scenario_ui</name>
  <version>0.1.0</version>
  <description>PyQt5 GUI for openarmx scenario player — main window (combo + Play/Cancel) + box-style sub-motion player. Talks to openarmx_scenario_player via PlayScenario action / ListScenarios service.</description>
  <maintainer email="trworker3@gmail.com">TR-Works</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <exec_depend>openarmx_scenario_player_msgs</exec_depend>
  <exec_depend>openarmx_scenario_player</exec_depend>
  <exec_depend>openarmx_bringup</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <!-- Cartesian Control tab -->
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>shape_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <!-- Camera tab -->
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
