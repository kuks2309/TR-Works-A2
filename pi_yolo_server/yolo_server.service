[Unit]
Description=Hailo-8 YOLOv8s detection HTTP server (pi_yolo_server)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=argoon
WorkingDirectory=/home/argoon/AI/TR-Works
# Point HEF_PATH at your compiled model; LABELS_PATH at your class list.
Environment=TASK=seg
Environment=HEF_PATH=/home/argoon/AI/TR-Works/yolov8s_seg_minibox.hef
Environment=LABELS_PATH=/home/argoon/AI/TR-Works/labels.txt
Environment=OUTPUT_FORMAT=nms
Environment=HOST=0.0.0.0
Environment=PORT=8080
# System python3 already provides flask/numpy/opencv + hailo_platform (HailoRT 4.20.0).
ExecStart=/usr/bin/python3 server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
