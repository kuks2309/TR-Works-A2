# ---- ROS2 build artifacts ----
**/build/
**/install/
**/log/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/

# ---- Virtualenvs / large envs (NEVER commit) ----
**/venv/
**/.venv/
**/*_env/
Yolo/Yolov8/yolov8_env/

# ---- IDE / editor caches ----
.vscode/browse.vc.db*
.vscode/*.vc.db*
.vscode/ipch/
*.db-shm
*.db-wal
*.swp

# ---- OMC state ----
.omc/
**/.omc/

# ---- D435 capture datasets (image data, not source) ----
openarmx_ws/src/Sensor/RGBD/captures/

# ---- AI training workspace (large weights / dataset / HEF / HAR; keep out of git) ----
AI/
# 예외: pick_and_place/AI 는 VLA(Vision-Language-Action) 소스(LeRobot 플러그인/스크립트) → 추적.
# 단, 그 하위의 대용량 산출물(weights/dataset/outputs/HEF/HAR)은 계속 제외한다.
!openarmx_ws/src/pick_and_place/AI/
!openarmx_ws/src/pick_and_place/AI/**
openarmx_ws/src/pick_and_place/AI/**/outputs/
openarmx_ws/src/pick_and_place/AI/**/*.pth
openarmx_ws/src/pick_and_place/AI/**/*.pt
openarmx_ws/src/pick_and_place/AI/**/*.safetensors
openarmx_ws/src/pick_and_place/AI/**/*.ckpt
openarmx_ws/src/pick_and_place/AI/**/*.bin
openarmx_ws/src/pick_and_place/AI/**/*.onnx
openarmx_ws/src/pick_and_place/AI/**/*.hef
openarmx_ws/src/pick_and_place/AI/**/*.har

# ---- OS ----
.DS_Store
Thumbs.db

