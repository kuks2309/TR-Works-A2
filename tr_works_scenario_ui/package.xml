<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tr_works_scenario_ui</name>
  <version>0.1.0</version>
  <description>PyQt5 GUI for TR-Works scenario player — launches hardware bringup + scenario_player + Action client controls + status topic monitor</description>
  <maintainer email="trworker3@gmail.com">TR-Works</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <exec_depend>tr_works_scenario_player</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
