<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="windowTitle">
   <string>TR-Works Scenario Box UI</string>
  </property>
  <property name="geometry">
   <rect>
    <x>0</x><y>0</y><width>760</width><height>720</height>
   </rect>
  </property>
  <widget class="QWidget" name="centralwidget">
   <layout class="QVBoxLayout" name="rootLayout">

    <!-- ============== Load / File info ============== -->
    <item>
     <widget class="QGroupBox" name="grpLoad">
      <property name="title"><string>Scenario</string></property>
      <layout class="QGridLayout" name="loadLayout">
       <item row="0" column="0">
        <widget class="QPushButton" name="btnLoad">
         <property name="text"><string>Load Scenario...</string></property>
         <property name="styleSheet"><string>background-color:#eef; font-weight:bold; padding:8px;</string></property>
        </widget>
       </item>
       <item row="0" column="1">
        <widget class="QLabel" name="lblScenarioName">
         <property name="text"><string>(no scenario loaded)</string></property>
         <property name="styleSheet"><string>font-weight:bold;</string></property>
        </widget>
       </item>
       <item row="0" column="2">
        <widget class="QLabel" name="lblSpeedTitle"><property name="text"><string>Speed:</string></property></widget>
       </item>
       <item row="0" column="3">
        <widget class="QComboBox" name="cmbSpeed">
         <property name="currentIndex"><number>2</number></property>
         <item><property name="text"><string>0.50x</string></property></item>
         <item><property name="text"><string>0.75x</string></property></item>
         <item><property name="text"><string>1.00x</string></property></item>
         <item><property name="text"><string>1.25x</string></property></item>
         <item><property name="text"><string>1.50x</string></property></item>
        </widget>
       </item>
       <item row="1" column="0" colspan="4">
        <widget class="QLabel" name="lblScenarioPath">
         <property name="text"><string>Path: -</string></property>
         <property name="styleSheet"><string>color:#555; font-family:monospace; font-size:11px;</string></property>
         <property name="wordWrap"><bool>true</bool></property>
        </widget>
       </item>
       <item row="2" column="0" colspan="3">
        <widget class="QCheckBox" name="chkDryRun">
         <property name="text"><string>Dry-run (publish 안 함, 로그만)</string></property>
        </widget>
       </item>
       <item row="2" column="3">
        <widget class="QPushButton" name="btnCancel">
         <property name="text"><string>■  Cancel</string></property>
         <property name="styleSheet"><string>background-color:#fed; color:#c00; font-weight:bold; padding:6px;</string></property>
        </widget>
       </item>
      </layout>
     </widget>
    </item>

    <!-- ============== Motion Boxes ============== -->
    <item>
     <widget class="QGroupBox" name="grpBoxes">
      <property name="title"><string>Motions  (click a box to play that sub-scenario)</string></property>
      <layout class="QVBoxLayout" name="boxesOuterLayout">
       <item>
        <widget class="QScrollArea" name="scrollBoxes">
         <property name="widgetResizable"><bool>true</bool></property>
         <widget class="QWidget" name="boxesContainer">
          <layout class="QGridLayout" name="boxesGrid"/>
         </widget>
        </widget>
       </item>
      </layout>
     </widget>
    </item>

    <!-- ============== Progress ============== -->
    <item>
     <widget class="QGroupBox" name="grpProgress">
      <property name="title"><string>Progress</string></property>
      <layout class="QVBoxLayout" name="prgLayout">
       <item><widget class="QLabel" name="lblProgressText"><property name="text"><string>Idle</string></property></widget></item>
       <item>
        <widget class="QProgressBar" name="prgOverall">
         <property name="minimum"><number>0</number></property>
         <property name="maximum"><number>100</number></property>
         <property name="value"><number>0</number></property>
        </widget>
       </item>
      </layout>
     </widget>
    </item>

    <!-- ============== Log ============== -->
    <item>
     <widget class="QGroupBox" name="grpLog">
      <property name="title"><string>Log</string></property>
      <layout class="QVBoxLayout" name="logLayout">
       <item>
        <widget class="QTextEdit" name="txtLog">
         <property name="readOnly"><bool>true</bool></property>
         <property name="styleSheet"><string>font-family:monospace; font-size:11px;</string></property>
        </widget>
       </item>
       <item>
        <widget class="QPushButton" name="btnClearLog"><property name="text"><string>Clear Log</string></property></widget>
       </item>
      </layout>
     </widget>
    </item>

   </layout>
  </widget>
  <widget class="QStatusBar" name="statusbar"/>
 </widget>
 <resources/>
 <connections/>
</ui>
